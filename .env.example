# SAFE DEFAULTS ONLY. Copy to .env locally; DO NOT commit .env.
APP_ENV=development
LAB_ENABLE_UNSAFE=false

# To run the classroom demo on YOUR OWN machine only, set BOTH:
# APP_ENV=local
# LAB_ENABLE_UNSAFE=true

# Host ports (always bound to 127.0.0.1). Change if a port is already in use.
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5433

# Local-only database credentials. Defaults in infra/compose.yaml are disposable;
# override here if you prefer. Never reuse real passwords.
# POSTGRES_USER=queryshield
# POSTGRES_PASSWORD=...
# LAB_QUERY_DB_PASSWORD=...
# LAB_APP_DB_PASSWORD=...
