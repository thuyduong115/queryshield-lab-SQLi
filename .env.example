# SAFE DEFAULTS ONLY. Copy to .env locally; DO NOT commit .env.
APP_ENV=development
LAB_ENABLE_UNSAFE=false

# Example local service wiring. The API uses the DB internal Compose host.
WEB_PORT=5173
API_PORT=8000
POSTGRES_DB=queryshield_lab
POSTGRES_HOST=db
POSTGRES_PORT=5433

# Provide locally only in .env, do not use fixture passwords for DB credentials.
# POSTGRES_USER=...
# POSTGRES_PASSWORD=...
# LAB_READONLY_DATABASE_URL=...
# LAB_RESULTS_DATABASE_URL=...

# Optional host-only DBeaver mapping; disabled by default.
# POSTGRES_HOST_PORT=5433
