          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"vulnerable\",\n  \"username\": \"admin' -- \",\n  \"password\": \"{{wrongPassword}}\",\n  \"test_case_id\": \"T03\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('outcome = AUTHENTICATED', () => pm.expect(body.outcome).to.eql('AUTHENTICATED'));",
              "pm.test('authenticated = true', () => pm.expect(body.authentication.authenticated).to.eql(true));",
              "pm.test('Có run_id', () => pm.expect(body.run_id).to.be.a('string'));",
              "pm.test('Mật khẩu không bị phản hồi lại', () => pm.expect(pm.response.text()).to.not.include(pm.variables.get('wrongPassword')));",
              "pm.collectionVariables.set('lastRunId', body.run_id);",
              "pm.test('Không có cookie/token', () => { pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false; });"
            ]
          }
        }
      ]
    },
    {
      "name": "SecureDesk · phiên mô phỏng từ run tấn công",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/securedesk/simulated-session/{{lastRunId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "securedesk",
            "simulated-session",
            "{{lastRunId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Chỉ là mô phỏng, vai trò admin', () => { const b = pm.response.json(); pm.expect(b.simulated).to.be.true; pm.expect(b.profile.role).to.eql('admin'); });",
              "pm.test('Không có cookie/token', () => { pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false; });"
            ]
          }
        }
      ]
    },
