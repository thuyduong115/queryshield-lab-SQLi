{
  "info": {
    "name": "QueryShield Lab",
    "description": "Bộ request cục bộ cho kịch bản login-bypass. Chỉ dùng với stack chạy trên 127.0.0.1. Mật khẩu là fixture công khai dùng một lần, lưu trong biến collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('CSDL sẵn sàng', () => pm.expect(pm.response.json().database).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách kịch bản",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/labs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "labs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Có login-bypass', () => pm.expect(pm.response.json().scenarios.map(s => s.id)).to.include('login-bypass'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Test case (không chứa mật khẩu)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/labs/login-bypass/test-cases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "labs",
            "login-bypass",
            "test-cases"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Không lộ mật khẩu fixture', () => pm.expect(pm.response.text()).to.not.include(pm.variables.get('validPassword')));"
            ]
          }
        }
      ]
    },
    {
      "name": "T01 · Đăng nhập hợp lệ (secure)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/labs/login-bypass/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "labs",
            "login-bypass",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"secure\",\n  \"username\": \"student01\",\n  \"password\": \"{{validPassword}}\",\n  \"test_case_id\": \"T01\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('outcome = AUTHENTICATED', () => pm.expect(body.outcome).to.eql('AUTHENTICATED'));",
              "pm.test('authenticated = true', () => pm.expect(body.authentication.authenticated).to.eql(true));",
              "pm.test('Có run_id', () => pm.expect(body.run_id).to.be.a('string'));",
              "pm.test('Mật khẩu không bị phản hồi lại', () => pm.expect(pm.response.text()).to.not.include(pm.variables.get('validPassword')));",
              "pm.collectionVariables.set('lastRunId', body.run_id);",
              "pm.test('Không có cookie/token', () => { pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false; });"
            ]
          }
        }
      ]
    },
    {
      "name": "T02 · Sai mật khẩu (secure)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/labs/login-bypass/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "labs",
            "login-bypass",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"secure\",\n  \"username\": \"student01\",\n  \"password\": \"{{wrongPassword}}\",\n  \"test_case_id\": \"T02\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('outcome = DENIED', () => pm.expect(body.outcome).to.eql('DENIED'));",
              "pm.test('authenticated = false', () => pm.expect(body.authentication.authenticated).to.eql(false));",
              "pm.test('Có run_id', () => pm.expect(body.run_id).to.be.a('string'));",
              "pm.test('Mật khẩu không bị phản hồi lại', () => pm.expect(pm.response.text()).to.not.include(pm.variables.get('wrongPassword')));",
              "pm.collectionVariables.set('lastRunId', body.run_id);",
              "pm.test('Không có cookie/token', () => { pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false; });"
            ]
          }
        }
      ]
    },
    {
      "name": "T03 · Tấn công (vulnerable)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
