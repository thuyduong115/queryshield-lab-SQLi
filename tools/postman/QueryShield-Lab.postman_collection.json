            ]
          }
        }
      ]
    },
    {
      "name": "Chạy bộ kiểm thử T01–T08",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/labs/login-bypass/tests/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "labs",
            "login-bypass",
            "tests",
            "run"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('16 lần chạy', () => pm.expect(b.total).to.eql(16));",
              "pm.test('Không có ca trượt', () => pm.expect(b.failed).to.eql(0));",
              "pm.test('Không ghi Đạt cho ca bị bỏ qua', () => b.results.filter(r => r.status === 'skipped').forEach(r => pm.expect(r.passed).to.be.null));"
            ]
          }
        }
      ]
    },
    {
      "name": "Kết quả gần nhất",
      "request": {
        "method": "GET",
        "header": [
